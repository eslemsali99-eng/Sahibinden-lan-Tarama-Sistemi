{
  "manifest_version": 3,
  "name": "Bircan Akın · İlan Tarama",
  "version": "3.4",
  "description": "Sahibinden ilan listelerini Bircan Akın CRM toplayıcısına aktarır.",
  "permissions": ["alarms", "tabs"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.sahibinden.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["*://*.sahibinden.com/*", "http://localhost/*", "https://bircan-emlak-crm.onrender.com/*", "https://api.ocr.space/*"]
}
