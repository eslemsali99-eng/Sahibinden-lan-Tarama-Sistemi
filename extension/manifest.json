{
  "manifest_version": 3,
  "name": "Bircan Akın · İlan Tarama",
  "version": "2.2",
  "description": "Sahibinden ilan listelerini Bircan Akın CRM toplayıcısına aktarır.",
  "content_scripts": [
    {
      "matches": ["*://*.sahibinden.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["*://*.sahibinden.com/*", "http://localhost/*"]
}
